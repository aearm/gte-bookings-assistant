# Copy this file to ".env" and fill in your details.

# Your Claude API key from https://platform.claude.com/settings/keys
# Easiest and safest: leave this as is and save the key on the app's Settings page instead
# (stored in Windows Credential Manager, not in this file).
ANTHROPIC_API_KEY=sk-ant-...

# Model to use. Sonnet is a good balance of quality and cost.
CLAUDE_MODEL=claude-sonnet-5-5

# Where data comes from:
#   auto  = live server on Windows, local files (data/local) on Mac
#   ssas  = always the live Analysis Services server (Windows only)
#   local = always the CSV/Excel files in data/local
DATA_SOURCE=auto

# ---- Live server settings (Windows only; ignored in local mode) ----
# Your Analysis Services server and model (Power BI > Data source settings shows both),
# e.g. SSAS_SERVER=bi.company.com:2383 and SSAS_DATABASE=Bookings.
# You can also set them on the app's Settings page.
SSAS_SERVER=
SSAS_DATABASE=

# The username you use for this server in Excel/Power BI, exactly as you type it there
# (often DOMAIN\username or name@company.com). Leave blank to use your Windows login.
# You can also set it on the app's Settings page.
SSAS_USERNAME=

# Don't put the password here. Save it on the app's Settings page (or run
# "python set_password.py"): it is stored securely in Windows Credential Manager.

# Leave blank unless needed:
# Folder containing Microsoft.AnalysisServices.AdomdClient.dll (normally found automatically)
ADOMD_PATH=
# Extra connection settings, only if IT says so
SSAS_CONNECTION_EXTRA=

# Maximum rows pulled per question
MAX_ROWS=5000
